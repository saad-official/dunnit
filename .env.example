# Copy to .env.local for development. Never commit real values.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Dunnit

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# LLM providers (free tiers). Groq is primary, Gemini is fallback and vision.
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
AI_PRIMARY_MODEL=openai/gpt-oss-20b
AI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Stripe (sandbox / test mode only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO_MONTHLY=

# Email. Leave RESEND_API_KEY empty to use the in-app Outbox only.
# With a key but no verified domain, set EMAIL_DEMO_RECIPIENT to your own address:
# every message is delivered there with a banner naming the intended recipient.
RESEND_API_KEY=
EMAIL_FROM=Dunnit <onboarding@resend.dev>
EMAIL_DEMO_RECIPIENT=

# Background jobs
CRON_SECRET=
